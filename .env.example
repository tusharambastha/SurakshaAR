# Supabase — get from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Blockchain mode: 'local' (demo/hackathon) | 'polygon' (real chain)
VITE_CHAIN_MODE=local

# Google Gemini API Key (Backend serverless proxy / local dev — NEVER exposed to browser)
# Get a free key in 1 click at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Suraksha Mitra AI Chatbot Backend URL
# - Local development: Leave empty to use local Vite dev server proxy (/api/chat)
# - Cloudflare Worker production: https://suraksha-chat-worker.<your-subdomain>.workers.dev/api/chat
VITE_CHAT_API_URL=
